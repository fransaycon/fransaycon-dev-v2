# Copy this file to `.env` and fill in the values.
# `.env` is gitignored — never commit real keys.
# Only VITE_-prefixed vars are exposed to the client (see src/env.ts).

# Web3Forms access key for the contact form.
# Get one free at https://web3forms.com (enter your email, they email you a key).
VITE_WEB3FORM_ACCESS_KEY=

# Canonical site origin used to build absolute URLs for SEO/social previews.
# e.g. https://fransaycon.dev
VITE_SITE_URL=
